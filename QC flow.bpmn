      <bpmn:escalationEventDefinition id="EscalationEventDefinition_1ww6wlu" escalationRef="Escalation_08hh9ie" />
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="Activity_1ue362f" name="QC Processing">
      <bpmn:incoming>Flow_1smwdf9</bpmn:incoming>
      <bpmn:outgoing>Flow_1bq6yhf</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=requiredQCs" inputElement="condition" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:userTask id="Activity_1ekgekp" name="Assign to QC">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="qc" />
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1h7e2vy</bpmn:incoming>
        <bpmn:outgoing>Flow_027ier3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="Event_1b48rbz" name="Every 24 hour(3)" cancelActivity="false" attachedToRef="Activity_1ekgekp">
        <bpmn:outgoing>Flow_13d8zxf</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_0ymq0kj">
          <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R3/P1D</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_027ier3" sourceRef="Activity_1ekgekp" targetRef="Gateway_1b0r2ny" />
      <bpmn:sequenceFlow id="Flow_0asmhfc" sourceRef="Activity_090c1o0" targetRef="Event_1alst1u" />
      <bpmn:sequenceFlow id="Flow_1h7e2vy" sourceRef="Event_0jgktbt" targetRef="Activity_1ekgekp" />
      <bpmn:sequenceFlow id="Flow_13opyl4" name="No" sourceRef="Gateway_1b0r2ny" targetRef="Event_01xb1fo">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=qcApproved = "no"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:endEvent id="Event_0fod6wu" name="QC Approved">
        <bpmn:incoming>Flow_0yz9l9g</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_1b0r2ny" name="QC approved?">
        <bpmn:incoming>Flow_027ier3</bpmn:incoming>
        <bpmn:outgoing>Flow_0yz9l9g</bpmn:outgoing>
        <bpmn:outgoing>Flow_13opyl4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:startEvent id="Event_0jgktbt" name="QC Assigment ">
