      </bpmn:startEvent>
      <bpmn:endEvent id="Event_01xb1fo" name="QC Declined">
        <bpmn:incoming>Flow_13opyl4</bpmn:incoming>
        <bpmn:escalationEventDefinition id="EscalationEventDefinition_01ilwt1" escalationRef="Escalation_08hh9ie" />
      </bpmn:endEvent>
      <bpmn:endEvent id="Event_1alst1u" name="QC Reminder">
        <bpmn:incoming>Flow_0asmhfc</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sendTask id="Activity_090c1o0" name="Send reminder via mail">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="sendReminderToQC" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_13d8zxf</bpmn:incoming>
        <bpmn:outgoing>Flow_0asmhfc</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_0yz9l9g" name="Yes" sourceRef="Gateway_1b0r2ny" targetRef="Event_0fod6wu">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=qcApproved = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_13d8zxf" sourceRef="Event_1b48rbz" targetRef="Activity_090c1o0" />
      <bpmn:textAnnotation id="TextAnnotation_0iu2pwg">
        <bpmn:text>This can be be service task, as we keep the users in the external system</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0sla5mn" associationDirection="None" sourceRef="Activity_1ekgekp" targetRef="TextAnnotation_0iu2pwg" />
    </bpmn:subProcess>
    <bpmn:textAnnotation id="TextAnnotation_171jx85">
      <bpmn:text>Some other flow to take, in case of QC declined</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1nayznt" associationDirection="None" sourceRef="Event_1c0g8ox" targetRef="TextAnnotation_171jx85" />
