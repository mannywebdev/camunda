  <bpmn:process id="Process_1akmyzr" name="QC flow" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_1" name="Claim Initiated">
      <bpmn:outgoing>Flow_14pb7em</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_1e0tvbj" name="Claim Processed">
      <bpmn:incoming>Flow_1bq6yhf</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Activity_0x6r33k" name="Determine the QCs required">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="determineRequiredQCs" resultVariable="requiredQCs" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14pb7em</bpmn:incoming>
      <bpmn:outgoing>Flow_1smwdf9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="Event_1c0g8ox" name="Flow Diversion">
      <bpmn:incoming>Flow_0v6bbt4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0v6bbt4" sourceRef="Event_19d8qzl" targetRef="Event_1c0g8ox" />
